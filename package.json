{
  "name": "swarm-mcp",
  "version": "2.0.0-rc.1",
  "type": "module",
  "engines": { "node": ">=22" },
  "bin": {
    "swarm-mcp": "./dist/cli.js",
    "swarm-legacy-guard": "./dist/legacy-guard-cli.js",
    "swarm-coordinator-migrate": "./dist/coordination/migration-cli.js",
    "swarm-coordinator-client": "./dist/coordination/client-cli.js",
    "swarm-coordinator-mcp": "./dist/coordination/mcp-cli.js",
    "swarm-coordinator-owner": "./dist/coordination/owner-cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/index.js",
    "dist/legacy-guard-cli.js",
    "dist/coordination/client-cli.js",
    "dist/coordination/migration-cli.js",
    "dist/coordination/mcp-cli.js",
    "dist/coordination/owner-cli.js",
    "dist/coordination/claude-hook-cli.js",
    "dist/coordination/claude-launcher.js",
    "dist/coordination/codex-launcher.js",
    "dist/coordination/dispatch-runner.js",
    "dist/coordination/opencode-dispatch.js",
    "dist/coordination/opencode-plugin.js",
    "sql",
    "skills/swarm-mcp",
    "skills/README.md",
    "bun.lock",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node dist/cli.js",
    "dev:server": "cargo run --manifest-path apps/swarm-server/Cargo.toml",
    "dev:ui": "cd apps/swarm-ui && SWARM_UI_MANAGE_DAEMON=0 bunx tauri dev",
    "dev:ui:managed": "cd apps/swarm-ui && bunx tauri dev",
    "diagrams": "node scripts/render-mermaid.mjs",
    "generate:protocol": "node scripts/generate-protocol-types.mjs",
    "build": "node scripts/build.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "check:ui": "cd apps/swarm-ui && bun run check && bun run build",
    "test:server": "cargo test --manifest-path apps/swarm-server/Cargo.toml",
    "test:tauri": "cargo test --manifest-path apps/swarm-ui/src-tauri/Cargo.toml",
    "typecheck": "node scripts/generate-protocol-types.mjs && tsc --noEmit",
    "test": "node scripts/generate-protocol-types.mjs && bun test && python3 -m unittest integrations.hermes.test_lifecycle integrations._shared.test_swarm_hook_core",
    "check": "bun run typecheck && bun run test && bun run build && bun run check:ui && bun run test:server && bun run test:tauri",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@opencode-ai/sdk": "1.4.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^11.7.0",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.12.0",
    "bun-types": "^1.3.11",
    "esbuild": "^0.24.2",
    "typescript": "^5.9.3"
  }
}
