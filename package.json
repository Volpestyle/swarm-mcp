    "zod": "4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.12.0",
    "bun-types": "^1.3.11",
    "esbuild": "^0.24.2",
    "typescript": "^5.9.3"
  },
  "exports": {
    "./runtime": {
      "types": "./dist/types/coordination/runtime.d.ts",
