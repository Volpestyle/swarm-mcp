    "swarm-mcp": "./dist/coordination/mcp-cli.js",
    "swarm-legacy-guard": "./dist/legacy-guard-cli.js",
    "swarm-coordinator-migrate": "./dist/coordination/migration-cli.js",
    "swarm-coordinator-client": "./dist/coordination/client-cli.js",
    "swarm-coordinator-mcp": "./dist/coordination/mcp-cli.js",
    "swarm-coordinator-owner": "./dist/coordination/owner-cli.js",
    "swarm-coordinator-maintenance": "./dist/coordination/maintenance-cli.js"
  },
  "files": [
    "dist/legacy-guard-cli.js",
    "dist/coordination/client-cli.js",
    "dist/coordination/migration-cli.js",
    "dist/coordination/mcp-cli.js",
    "dist/coordination/owner-cli.js",
    "dist/coordination/maintenance-cli.js",
    "dist/coordination/claude-hook-cli.js",
    "dist/coordination/claude-launcher.js",
    "dist/coordination/codex-launcher.js",
    "dist/coordination/dispatch-runner.js",
    "dist/coordination/opencode-dispatch.js",
    "dist/coordination/opencode-plugin.js",
    "skills/swarm-mcp",
    "skills/README.md",
    "bun.lock",
    "README.md",
    "LICENSE",
    "dist/coordination/runtime.js",
    "dist/types",
    "dist/coordination/herdr-worker-cli.js",
    "docs/runtime-embedding.md"
  ],
  "scripts": {
    "start": "node dist/coordination/mcp-cli.js",
    "diagrams": "node scripts/render-mermaid.mjs",
    "build": "node scripts/build.mjs",
    "verify:package": "node scripts/verify-package.mjs",
